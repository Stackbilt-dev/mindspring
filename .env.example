# MindSpring — Environment Configuration
# Copy to .env and fill in your values.

# Cloudflare API token (required for wrangler deploy)
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# MindSpring API key (admin-scoped, for local testing / scripts)
MINDSPRING_API_KEY=

# MindSpring API URL (production endpoint)
MINDSPRING_API_URL=https://mindspring.<your-subdomain>.workers.dev
